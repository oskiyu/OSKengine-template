<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="oskiyu.gamemin.template"
          android:versionCode="1"
          android:versionName="2026.1.0">

<uses-sdk android:minSdkVersion="34" android:targetSdkVersion="34" />

  <application
      android:allowBackup="false"
      android:fullBackupContent="false"
      android:label="OSKengine Game Template"
      android:hasCode="false"
      android:debuggable="true"
      android:icon="@mipmap/oskengine_logo"
      android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

    <activity android:name="android.app.NativeActivity"
              android:label="OSKengine Game Template"
              android:configChanges="orientation|keyboardHidden"
              android:screenOrientation="landscape"
              android:exported="true"
              android:immersive="true">
              
      <meta-data android:name="android.app.lib_name" android:value="GameMin"/>

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

    </activity>
  </application>

</manifest>
